 int maxArea(vector<int>& arr) {
        int n=arr.size();
        int ans=0;
        int i=0;
        int j=n-1;//to maximize length
        while(i<j)
        {
            int height=min(arr[i],arr[j]);
            int len=j-i;
            int temparea=height*len;
            ans=max(temparea, ans);
            if(arr[i]<arr[j])
            i++;
            else
            j--;
        }
        return ans;
    }
    //time complexity O(n) and space complexity O(1)       